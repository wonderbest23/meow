{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "today-startup",
  "main": "cloudflare-worker.ts",
  // 공개 주소는 oneulstart.com 하나만 쓴다. workers.dev·미리보기 주소는 Cloudflare Access 밖에서 관리자 화면이 열려 끈다(2026-09-28 출시 전 QA).
  // 서버 내부 호출은 서비스 바인딩(WORKER_SELF_REFERENCE)을 써서 이 주소와 무관하다.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "oneulstart.com",
      "custom_domain": true
    },
    {
      "pattern": "www.oneulstart.com",
      "custom_domain": true
    },
    {
      "pattern": "connect.oneulstart.com",
      "custom_domain": true
    },
    {
      "pattern": "*/*",
      "zone_name": "oneulstart.com"
    }
  ],
  "compatibility_date": "2026-07-14",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "placement": {
    "region": "aws:us-east-1"
  },
  // 43k자 사업계획서 PDF 렌더가 기본 CPU 한도(30초) 언저리라 간헐적으로 503이 났다.
  // 유료 플랜 상한(5분)으로 올린다 — 실제로는 수십 초만 쓴다.
  "limits": {
    "cpu_ms": 300000
  },
  // 5분마다: 홈페이지 문의 알림 중 재시도 시각이 된 것·전송 도중 끊긴 것을 다시 보낸다(cloudflare-worker.ts scheduled).
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-sol",
    "PAYMENTS_ENABLED": "true",
    "PLATFORM_OPERATOR_NAME": "제이피미디어",
    "PLATFORM_REPRESENTATIVE_NAME": "김홍",
    "PLATFORM_BUSINESS_NUMBER": "186-17-01752",
    "PLATFORM_MAIL_ORDER_STATUS": "preparing",
    "PLATFORM_INTERNET_DOMAIN": "oneulstart.com",
    "PLATFORM_HOST_SERVER_LOCATION": "Cloudflare 글로벌 네트워크",
    "PLATFORM_BUSINESS_ADDRESS": "서울특별시 마포구 독막로6길9",
    "MANUAL_TRANSFER_BANK_NAME": "카카오뱅크",
    "MANUAL_TRANSFER_ACCOUNT_NUMBER": "3333-01-4982733",
    "MANUAL_TRANSFER_ACCOUNT_HOLDER": "김주홍",
    "CLOUDFLARE_ZONE_ID": "b8bca144e4ce0ddd7ba6a375271d5c39",
    "CLOUDFLARE_SAAS_CNAME_TARGET": "connect.oneulstart.com",
    // 첫 사업 설명에 붙는 AI 참고 의견(시험 기능). 끄려면 "0". 대시보드에서 바꾼 일반 변수는 배포 때 이 목록으로 덮어써진다.
    "INTAKE_LIVE_COMMENT": "1",
    // 첫 사업 설명에 맞춘 답변 추천 칩(시험 기능). 끄려면 "0".
    "INTAKE_ANSWER_SUGGESTIONS": "1",
    // 사용 한도를 워커 인스턴스별 메모리가 아니라 DB 공유 카운터(마이그레이션 0018 bump_rate_limit)로 센다. DB 오류 시 메모리 한도로 내려간다.
    "RATE_LIMIT_BACKEND": "supabase",
    // 추천 칩에만 쓰는 모델. 비워 두면 기본 텍스트 모델(Opus)을 쓴다.
    // Haiku 4.5 비교(2026-09): 중간값 4.3초 vs Opus 7.9초로 빨랐지만, 세무 신고 대행처럼 법적으로 위험한 추천과
    // 설명에 없는 위치·시간을 지어낸 추천이 나와 Opus로 되돌렸다.
    "INTAKE_SUGGEST_MODEL": "",
    // 사장님 문자 알림(새 문의·주간 리포트, 알리고 중계 v3). 중계 주소·비밀값·모드는 대표 알림과 같은 비밀값을 쓴다.
    // 중계가 아직 v3 전이면 요청이 거절될 뿐 문자는 나가지 않는다. 끄려면 "0".
    "CUSTOMER_SMS_ENABLED": "1"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "today-startup"
    }
  ],
  "workflows": [
    {
      "name": "today-startup-draft-package",
      "binding": "DRAFT_PACKAGE_WORKFLOW",
      "class_name": "DraftPackageWorkflow"
    },
    {
      "name": "today-startup-direct-plan",
      "binding": "DIRECT_PLAN_WORKFLOW",
      "class_name": "DirectPlanWorkflow"
    },
    {
      "name": "today-startup-plan-sections",
      "binding": "PLAN_SECTIONS_WORKFLOW",
      "class_name": "PlanSectionsWorkflow"
    }
  ],
  "observability": {
    "enabled": true
  }
}
