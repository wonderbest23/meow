# _next/static 아래 파일은 이름에 내용 지문이 들어 있어(내용이 바뀌면 이름이 바뀐다) 1년 동안 다시 묻지 않는다(점검 r42-B).
# 예전엔 max-age=0 이라 다시 열 때마다 JS·CSS·글꼴 수십 개를 서버에 다시 확인했다.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# /home-media 는 이름이 같은 채로 바뀔 수 있어 매번 확인한다(scripts/home-polish.test.ts)
/home-media/*
  Cache-Control: public,max-age=0,must-revalidate
