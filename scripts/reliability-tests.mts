  const timedOut = result.signal === "SIGTERM" || (result.error as NodeJS.ErrnoException | undefined)?.code === "ETIMEDOUT";
  console.log(`\n[${suite}] ${result.status === 0 ? "PASS" : timedOut ? "FAIL (60초 시간 초과)" : "FAIL"}\n${result.stdout}${result.stderr}`);
