{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "today-startup-staging",
  "main": "cloudflare-worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "limits": { "cpu_ms": 30000 },
  "vars": {
    "APP_ENV": "staging",
    "NEXT_PUBLIC_APP_ENV": "staging",
    "STAGING_READY": "false",
    "PLATFORM_APP_ORIGIN": "https://today-startup-staging.rena35200.workers.dev",
    "STAGING_SUPABASE_PROJECT_REF": "",
    "SUPABASE_URL": "",
    "PERSISTENCE_MODE": "supabase",
    "PLAN_ACCOUNT_LINKING_ENABLED": "true",
    "PAYMENTS_ENABLED": "false",
    "OPERATING_AI_ENABLED": "false",
    "PROPOSAL_AI_ENABLED": "false",
    "NEXT_PUBLIC_PPT_GENERATION_VERIFIED": "false",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID": "",
    "RATE_LIMIT_BACKEND": "supabase"
  },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "today-startup-staging" }],
  "workflows": [
    { "name": "today-startup-staging-draft-package", "binding": "DRAFT_PACKAGE_WORKFLOW", "class_name": "DraftPackageWorkflow" },
    { "name": "today-startup-staging-direct-plan", "binding": "DIRECT_PLAN_WORKFLOW", "class_name": "DirectPlanWorkflow" },
    { "name": "today-startup-staging-plan-sections", "binding": "PLAN_SECTIONS_WORKFLOW", "class_name": "PlanSectionsWorkflow" }
  ],
  "observability": { "enabled": true }
}
